# =============================================================================
# config.local.ps1.example — SECRETS TEMPLATE.
# Copy this file to "config.local.ps1" and fill in the real values.
# config.local.ps1 is gitignored and must NEVER be committed.
# =============================================================================

# Google OAuth client (reuse the same one as the Melissa project).
$GoogleClientId     = "YOUR_CLIENT_ID.apps.googleusercontent.com"
$GoogleClientSecret = "YOUR_CLIENT_SECRET"

# Berkeley refresh token WITH the gmail.readonly scope.
# Mint it once by running:  .\Get-RefreshToken.ps1
$GoogleRefreshToken = "YOUR_BERKELEY_REFRESH_TOKEN"

# --- Optional: Telegram alert on FAILURE (reuse the Melissa bot creds). ---
# Leave blank to disable. Success needs no alert — Google's own receipt email
# ("Thanks for filling out this form...") is the weekly proof of submission.
$TelegramToken  = ""
$TelegramChatId = ""
