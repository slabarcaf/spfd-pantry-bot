# Copy to ".env" and fill in. .env is gitignored — never commit it.

# Google OAuth client (reuse the SAME one as the Melissa project).
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Berkeley refresh token used ONLY to READ Gmail (find the weekly email).
# Must include the gmail.readonly scope. Melissa's Berkeley token may already
# have it ("Gmail + Calendar"); if Gmail calls 403, run:  npm run get-token
GOOGLE_REFRESH_TOKEN_BERKELEY=your_berkeley_refresh_token

# Optional: Telegram alert on failure (reuse the Melissa bot creds). The alert
# includes a 1-tap pre-filled form link so you can still register manually.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: use installed Google Chrome instead of bundled Chromium. Recommended
# value: chrome  — more reliable for the one-time Google login. Leave blank to
# use Playwright's bundled Chromium (npx playwright install chromium).
CHROME_CHANNEL=
